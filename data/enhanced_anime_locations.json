{
  "api_sources": {
    "animepilgrimage.com": {
      "description": "Comprehensive anime pilgrimage database with real filming locations",
      "coverage": "1000+ anime titles",
      "data_format": "Structured location data with coordinates and scene descriptions"
    },
    "anitabi.cn": {
      "description": "Chinese anime pilgrimage database with detailed location information",
      "coverage": "500+ anime titles",
      "data_format": "Detailed place information with episode references and images"
    },
    "wikidata": {
      "description": "Structured knowledge base with anime filming locations",
      "coverage": "Major anime productions",
      "data_format": "SPARQL query results with coordinates and descriptions"
    }
  },
  "supported_anime": [
    "Slam Dunk",
    "Your Name",
    "One Piece",
    "Naruto",
    "Attack on Titan",
    "Demon Slayer",
    "My Hero Academia",
    "Bunny Girl Senpai",
    "Weathering with You",
    "Silent Voice",
    "Death Note",
    "Fullmetal Alchemist",
    "Steins;Gate",
    "Re:Zero",
    "Sailor Moon",
    "Dragon Ball Z"
  ],
  "api_integration_config": {
    "priority_order": [
      "animepilgrimage.com",
      "anitabi.cn",
      "wikidata",
      "web_search_fallback",
      "intelligent_fallback"
    ],
    "rate_limiting": {
      "requests_per_minute": 60,
      "delay_between_requests": 1.0
    },
    "data_freshness": {
      "cache_duration_hours": 24,
      "force_refresh": false
    }
  },
  "location_enhancement": {
    "geocoding_enabled": true,
    "coordinate_precision": 6,
    "address_parsing": true,
    "scene_description_enhancement": true,
    "image_urls_enabled": true,
    "episode_referencing": true
  },
  "genre_templates": {
    "romance_school": {
      "common_settings": ["Tokyo", "Osaka", "Kyoto", "Yokohama"],
      "typical_locations": ["School buildings", "Train stations", "Parks", "Shopping districts", "Bridges"],
      "activities": ["Visit school locations", "Train ride experiences", "Scenic photography", "Local cuisine"]
    },
    "action_adventure": {
      "common_settings": ["Tokyo", "Mountains", "Islands", "Historical sites"],
      "typical_locations": ["Battle arenas", "Training grounds", "Landmarks", "Natural formations"],
      "activities": ["Location photography", "Hiking/tracking", "Museum visits", "Souvenir shopping"]
    },
    "slice_of_life": {
      "common_settings": ["Suburban areas", "Small towns", "Rural Japan"],
      "typical_locations": ["Homes", "Local shops", "Community centers", "Natural scenery"],
      "activities": ["Daily life photography", "Local interaction", "Seasonal events", "Traditional experiences"]
    }
  }
}