# OpenRouter API configuration (get a free API key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free-tier LLM model ("openrouter/free" auto-routes to available free models,
# or pin a specific :free model such as "meta-llama/llama-3.3-70b-instruct:free")
OPENROUTER_LLM_MODEL=openrouter/free

# Free-tier VLM model (used for future anime screenshot / photo-matching features)
OPENROUTER_VLM_MODEL=openrouter/free

# Optional comma-separated fallback models tried if the primary model is rate-limited
OPENROUTER_FALLBACK_MODELS=

# Optional OpenRouter app attribution headers
OPENROUTER_SITE_URL=https://github.com/TheMattBin/AnimePilgrimageTripPlanner
OPENROUTER_APP_NAME=Anime Pilgrimage Trip Planner

# Optional Tavily API key for higher-precision web search (defaults to free DuckDuckGo search)
TAVILY_API_KEY=

# OpenStreetMap Nominatim identification (required by Nominatim usage policy)
NOMINATIM_USER_AGENT=AnimePilgrimageTripPlanner/0.2
NOMINATIM_EMAIL=your_email@example.com

# Optional override for cache directory (unset defaults to <repo-root>/.cache)
# CACHE_DIR=/path/to/cache

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
